# Frontend Docker Compose configuration
# Copy this file to .env and edit paths to match your setup.
#
# See: docs/frontend-decision.md for architecture context.

# Path to the native ChromaDB backend's data directory.
# This is the ChromaDB persist directory used by the native (non-MemPalace) backend.
# REQUIRED — docker compose will error if not set.
# NOTE: Use absolute paths or $HOME — Docker Compose does not expand ~
NATIVE_CHROMADB_PATH=${HOME}/claude_docs/memory/chromadb

# Path to the MemPalace backend's ChromaDB data directory.
# Default: $HOME/.mempalace/palace (the mempalace library's default location).
MEMPALACE_CHROMADB_PATH=${HOME}/.mempalace/palace

# UID/GID that owns the palace directory. mempalace keeps it at mode 0700, so
# the container must run as that user or gunicorn crash-loops on a PermissionError.
# Find yours with: id -u ; id -g
FRONTEND_UID=1000
FRONTEND_GID=1000

# Address the frontend binds to. Loopback by default, on purpose: the page has
# NO authentication and serves the whole palace.
#
# Since gateway#16, LEAVE THIS AT LOOPBACK. The cloudflared sidecar reaches the
# frontend over the compose network and never touches this host port, so the
# public hostname works with this unset. Setting 0.0.0.0 serves the whole palace
# to the LAN WITHOUT the zone login, which is the hole gateway#16 closed.
# FRONTEND_BIND=0.0.0.0
